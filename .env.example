# Supabase — copy to `.env` and fill in your project values.
# Only the PUBLIC anon key is used in the browser (RLS-bound).
# The service-role key must NEVER appear here or in any VITE_ variable.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# hCaptcha — PUBLIC site key (safe to ship in the browser). Get one at
# https://dashboard.hcaptcha.com/. The matching SECRET key goes in the
# `register` Edge Function as a Supabase secret (HCAPTCHA_SECRET), never here.
VITE_HCAPTCHA_SITEKEY=your-hcaptcha-site-key

# External S3-compatible object storage (Backblaze B2 / Cloudflare R2) used by
# the media Edge Functions (passports + certificates). These are secrets: set
# them BOTH here (for local tooling) and as Supabase function secrets via
# `supabase secrets set` — never in any VITE_ variable.
# B2 example:
#   S3_ENDPOINT=https://s3.us-west-002.backblazeb2.com
#   S3_ACCESS_KEY_ID=your-application-key-id
#   S3_SECRET_ACCESS_KEY=your-application-key
#   S3_BUCKET=arise-media
